# Harness rules for AI agents and git hooks.
# Non-secret and committed. Secrets belong in .env, which agents must never read.
# Git hooks and scripts read ONLY this file (not the shell environment), so a prefix
# such as "REVIEW_BEFORE_PUSH=false git push" cannot lower the rules.
# Values must not contain " #" (it starts a comment).

# Native language of the team: interviews, PILOT.md, PLANKS.md, specs, PR descriptions.
# Empty means the agent must ask the user first and write the answer here.
NATIVE_LANGUAGE=pt-BR

# Code, identifiers, comments, commits, branches, test names, ADRs.
CODE_LANGUAGE=en

# Rigor level. R0 pilot | R1 daily use | R2 other people use it | R3 sensitive data.
# /harden raises it. Never lowered by an agent.
RIGOR=R0

# Directory that holds the four layers: core/ ports/ adapters/ app/
LAYERS_DIR=src

# How to start the product and how to run each group of tests. /start fills these in.
# Example: TEST_CORE_CMD=pytest acceptance/core -q
RUN_CMD=
TEST_CORE_CMD=
TEST_SPECS_CMD=
TEST_CONTRACTS_CMD=

# Optional backlog ordering: none | moscow | rice | ice (see BACKLOG.md and /backlog).
PRIORITIZATION=none

# Commits are never held for approval (a hook only checks the message format).
# Agents: never run git push without explicit approval in chat.
ASK_BEFORE_PUSH=true

# Push gates enforced by the pre-push hook:
# - the core acceptance tests pass (on from R1)
RUN_CORE_BEFORE_PUSH=false
# - CHANGELOG.md is up to date (scripts/changelog.sh)
ENFORCE_CHANGELOG=true
# - a review window shows the commits and asks for approval (on from R2)
REVIEW_BEFORE_PUSH=false

# auto | code | cursor | windsurf | editor | terminal
REVIEW_TOOL=auto

# Reject commit subjects that are not Conventional Commits.
ENFORCE_CONVENTIONAL_COMMITS=true

# Reject commits that modify or delete acceptance/core/ files without a "Core-Change:" footer.
PROTECT_CORE_TESTS=true
