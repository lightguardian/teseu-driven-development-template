# Harness rules for AI agents and git hooks.
# Non-secret and committed. Secrets belong in .env, which agents must never read.
# Git hooks and scripts read ONLY this file (not the shell environment), so a prefix
# such as "REVIEW_BEFORE_PUSH=false git push" cannot lower the rules.
# Values must not contain " #" (it starts a comment).

# Native language of the team: interviews, PILOT.md, PLANKS.md, specs, PR descriptions.
# Empty means the agent must ask the user first and write the answer here.
NATIVE_LANGUAGE=pt-BR

# Language of the specs (specs/*.md and the text of their criteria).
# Empty means the same as NATIVE_LANGUAGE. Section headings, ids, code and test names stay in English.
SPEC_LANGUAGE=

# Code, identifiers, comments, commits, branches, test names, ADRs.
CODE_LANGUAGE=en

# Who reviews the work between green and refactor:
#   auto      the built-in read-only reviewer agent (default)
#   external  you use another reviewer (a person, a review bot, another agent): the agent
#             does not run its own, waits for your verdict and records it
#   off       no review phase: refactor follows green
REVIEW_MODE=auto

# Rigor level. R0 pilot | R1 daily use | R2 other people use it | R3 sensitive data.
# /harden raises it. Never lowered by an agent.
RIGOR=R0

# Directory that holds the four layers: core/ ports/ adapters/ app/
LAYERS_DIR=src

# How to start the product and how to run each group of tests. /start fills these in.
# Only the core tests (acceptance/core) are black-box. The tests of the specs are the
# language's usual ones, and you choose the style:
#   unit   unit tests of the core and the adapters, with fakes behind the ports (default)
#   e2e    end-to-end tests that drive the whole product
#   mixed  the agent picks per requirement (unit for rules, e2e for flows)
SPEC_TEST_STYLE=unit

# Where the tests of the specs live, following the language's convention (tests, src, ...).
# Their names carry the spec id (S0001_R1_...) and NEGATIVE when they are negative tests.
SPEC_TESTS_DIR=tests

# How much testing the method asks for. Tests are optional, and you choose:
#   none   no tests at all: nothing is run or required (some things cannot be tested)
#   unit   only the language's own tests
#   core   (default) a black-box core test for the pilot, and the language's own tests
#   full   also one black-box test for every feature spec
# A single demand can opt out with "tests: none" in its spec. "Black-box" means
# end-to-end through the product's public edge, with whatever tool you prefer.
TEST_LEVEL=core

# When there are tests, verification has two stages, always in this order:
#   stage 1, black-box (the central tests): core, then the features
#   stage 2, the language's own tests: the spec, the other specs, the contracts
# Example (Python): TEST_CORE_CMD=pytest acceptance/core -q
RUN_CMD=
TEST_CORE_CMD=
# The black-box tests of all the features. Example: pytest acceptance/features -q
TEST_FEATURES_CMD=
# The black-box test of ONE feature; {spec} becomes its id, like S0001. Example: pytest acceptance/features -q -k {spec}
TEST_FEATURE_CMD=
# All the tests of the specs. Example: pytest tests -q
TEST_SPECS_CMD=
# The tests of ONE spec; {spec} becomes its id, like S0001. Example: pytest tests -q -k {spec}
TEST_SPEC_CMD=
TEST_CONTRACTS_CMD=

# Optional backlog ordering: none | moscow | rice | ice (see BACKLOG.md and /backlog).
PRIORITIZATION=none

# Commits are never held for approval (a hook only checks the message format).
# Agents: never run git push without explicit approval in chat.
ASK_BEFORE_PUSH=true

# Push gates enforced by the pre-push hook:
# - the core acceptance tests pass (on from R1)
RUN_CORE_BEFORE_PUSH=false
# - CHANGELOG.md is up to date (scripts/changelog.sh)
ENFORCE_CHANGELOG=true
# - a review window shows the commits and asks for approval (on from R2)
REVIEW_BEFORE_PUSH=false

# auto | code | cursor | windsurf | editor | terminal
REVIEW_TOOL=auto

# Reject commit subjects that are not Conventional Commits.
ENFORCE_CONVENTIONAL_COMMITS=true

# Reject commits that modify or delete black-box tests without a footer:
# "Core-Change:" for acceptance/core/, "Acceptance-Change:" for acceptance/features/.
PROTECT_CORE_TESTS=true
